{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trajectory",
  "type": "object",
  "required": [
    "version",
    "skill",
    "args",
    "dt",
    "joints",
    "segments"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "object"
    },
    "dt": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.1
    },
    "joints": {
      "const": [
        "shoulder_pan",
        "shoulder_lift",
        "elbow_flex",
        "wrist_flex",
        "wrist_roll"
      ]
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "q"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "path"
              },
              "q": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 5,
                  "maxItems": 5,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "action"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "grip"
              },
              "action": {
                "enum": [
                  "open",
                  "close"
                ]
              },
              "object": {
                "type": "string"
              },
              "expect_held": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "primitive"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "live"
              },
              "primitive": {
                "enum": [
                  "carry_to_hand",
                  "home"
                ]
              },
              "object": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
