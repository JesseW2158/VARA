# Copy to .env and fill in. .env is gitignored, and .claude/settings.json denies Claude Code reading it.
XAI_API_KEY=
DAYTONA_API_KEY=

# A fast Grok model for routing and success specs, and the strongest one your key lists for code.
ROUTER_MODEL=
CODEGEN_MODEL=

# From lerobot-find-port, for example /dev/ttyACM0 or COM5. Re-run after any replug.
FOLLOWER_PORT=
LEADER_PORT=

# Camera indices from lerobot-find-cameras opencv
OVERHEAD_CAM=0
WRIST_CAM=1

# 1 = judging budgets: no repair round, 75 s cap from command to arm moving
DEMO_MODE=0

# 1 = every fake (no arm, cameras, xAI or Daytona). Or set FAKE_LLM, FAKE_SANDBOX, FAKE_ROBOT, FAKE_CAMERA one by one.
FAKE=0
