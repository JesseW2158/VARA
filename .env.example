# Copy to .env and fill in. .env is gitignored, and .claude/settings.json denies Claude Code reading it.
XAI_API_KEY=
DAYTONA_API_KEY=

# Optional, read by the Daytona SDK inside Daytona(): the API endpoint (default https://app.daytona.io/api)
# and the sandbox region. Leave them commented out unless Daytona tells you to set them.
# DAYTONA_API_URL=
# DAYTONA_TARGET=

# Empty = grok-4.3 for routing/success specs and grok-4.7 for code (verified 2026-10-17).
# Defaults request no reasoning for grok-4.3 routing and low reasoning for grok-4.7 code.
# See docs/setup.md for stage budgets, output caps and official model documentation.
ROUTER_MODEL=
CODEGEN_MODEL=
# Optional overrides: none, low, medium, high, xhigh (only values supported by your model).
# grok-4.7 cannot disable reasoning. Unknown model overrides get no effort unless explicitly set here.
ROUTER_REASONING_EFFORT=
CODEGEN_REASONING_EFFORT=

# From lerobot-find-port, for example /dev/ttyACM0 or COM5 (demo laptop: follower COM8, leader COM7). Re-run after any replug.
# Our code reads only the follower's port; the leader's is for the LeRobot CLIs (A3).
FOLLOWER_PORT=
LEADER_PORT=
# LeRobot calibration id of the follower. Empty = lerobot_id in config/joint_map.yaml (my_awesome_follower_arm).
FOLLOWER_ID=

# Camera indices from lerobot-find-cameras opencv; they override config/cameras.yaml (empty = its index).
# On the demo laptop index 0 is the built-in webcam (DSHOW only), so put the overhead camera's real index here.
OVERHEAD_CAM=0
WRIST_CAM=1

# 1 = judging budgets: no repair round, 75 s cap from command to arm moving
DEMO_MODE=0

# 1 = every fake (no arm, cameras, xAI or Daytona). Or set FAKE_LLM, FAKE_SANDBOX, FAKE_ROBOT, FAKE_CAMERA one by one.
FAKE=0
# 1 = model replies from tests/fixtures/llm/ instead of xAI; POST /voice/token returns a fake token.
FAKE_LLM=0
# 1 = score candidates in local clean subprocesses instead of Daytona (also what happens when DAYTONA_API_KEY is empty).
FAKE_SANDBOX=0
# 1 = an in-memory arm instead of the follower on FOLLOWER_PORT.
FAKE_ROBOT=0
# 1 = synthetic overhead and wrist cameras that render config/fake_scene.json.
FAKE_CAMERA=0

# Testing: move the skill library and the run folders (tests and scripts/e2e_fake.py point them at copies).
# Empty = skills/ and runs/ in the repo.
VARA_SKILLS_DIR=
VARA_RUNS_DIR=
